<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="2dp"
    android:paddingEnd="8dp"
    android:paddingBottom="2dp">

    <!-- Status Shield Icon -->
    <ImageView
        android:id="@+id/widget_status_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/widget_title_full"
        android:scaleType="centerInside" />

    <!-- Title "WhiteCall" -->
    <TextView
        android:id="@+id/widget_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="none"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/widget_title_full"
        android:textColor="@color/widget_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Incoming Call Flashing Handset Icon -->
    <ImageView
        android:id="@+id/widget_incoming_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <!-- Status text / Active Alert Caller Display -->
    <TextView
        android:id="@+id/widget_status_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/protection_status_active"
        android:textColor="@color/widget_status_active"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Block Counter Badge: "Блок: N" -->
    <TextView
        android:id="@+id/widget_blocked_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_badge_bg"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:ellipsize="none"
        android:maxLines="1"
        android:singleLine="true"
        android:text="Блок: 0"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Right: Power Button -->
    <ImageButton
        android:id="@+id/widget_toggle_button"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_toggle_protection"
        android:scaleType="centerInside" />

</LinearLayout>
